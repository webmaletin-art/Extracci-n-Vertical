; EXTRACCIÓN VERTICAL — shooter táctico de extracción 2.5D · Godot 4.7.2
config_version=5

[application]

config/name="Extracción Vertical"
config/description="Explora. Saquea. Sobrevive. Extrae."
config/version="0.1.0"
run/main_scene="res://boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.05, 0.06, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Settings="*res://systems/core/settings.gd"
Sfx="*res://systems/audio/sfx.gd"
NoiseBus="*res://systems/core/noise_bus.gd"
TimeFx="*res://systems/core/time_fx.gd"
Fx="*res://systems/fx/fx.gd"
TechView="*res://systems/render/tech_view.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jugadores"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="destructibles"
3d_physics/layer_5="proyectiles"
3d_physics/layer_6="interaccion"
3d_physics/layer_7="escombros"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.045, 1)
limits/opengl/max_lights_per_object=4
